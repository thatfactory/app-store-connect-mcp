{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "price": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "free"
            },
            "baseTerritory": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          },
          "required": [
            "mode",
            "baseTerritory"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "paid"
            },
            "baseTerritory": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "customerPrice": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
            }
          },
          "required": [
            "mode",
            "baseTerritory",
            "customerPrice"
          ],
          "additionalProperties": false
        }
      ]
    },
    "availability": {
      "type": "object",
      "properties": {
        "territories": {
          "anyOf": [
            {
              "type": "string",
              "const": "all"
            },
            {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              }
            }
          ]
        },
        "availableInNewTerritories": {
          "type": "boolean"
        }
      },
      "required": [
        "territories"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion"
  ],
  "additionalProperties": false
}
